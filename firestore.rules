rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sadece dükkan hesabıyla giriş yapan telefonlar okuyup yazabilir
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "dukkan@laststop-stok-4787.firebaseapp.com";
    }
  }
}
